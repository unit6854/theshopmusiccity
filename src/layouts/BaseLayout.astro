---
import { ClientRouter } from 'astro:transitions';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/shop.css';
import '../styles/cursor.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import settings from '../data/settings.json';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${settings.business_name} | Window Tint, Vinyl Wraps & Detailing in Madison, TN`,
  description = `Window tinting, vinyl wraps, paint protection and detailing in Madison, TN. Call ${settings.phone} to talk through your build with ${settings.business_name}.`,
} = Astro.props;

const SITE = 'https://theshopmusiccity.netlify.app';
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE);
const ogImage = new URL('/og.png', Astro.site ?? SITE);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.business_name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${settings.business_name} - custom automotive in Madison, TN`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#e2102f" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- The three faces that paint above the fold: the h1 (Saira 800), the
         eyebrow and nav (Saira 700) and the body copy (Barlow 400). Preloading
         them starts the download with the HTML instead of after the CSS has
         been parsed, which is what closes the window the font flash lived in.
         The rest of the weights load normally from fonts.css. -->
    <link rel="preload" href="/fonts/saira-condensed-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/saira-condensed-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-400.woff2" as="font" type="font/woff2" crossorigin />

    <ClientRouter />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'AutoBodyShop',
        name: settings.business_name,
        slogan: settings.tagline,
        telephone: settings.phone,
        email: settings.email,
        url: SITE,
        foundingDate: settings.founded,
        address: {
          '@type': 'PostalAddress',
          streetAddress: settings.address_line1,
          addressLocality: 'Madison',
          addressRegion: 'TN',
          postalCode: '37115',
          addressCountry: 'US',
        },
        openingHoursSpecification: [
          {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
            opens: '09:00',
            closes: '17:30',
          },
        ],
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: settings.rating,
          bestRating: '5',
          reviewCount: settings.review_count,
        },
      })}
    />
  </head>
  <body>
    <span class="page-wipe" aria-hidden="true"></span>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // ---- red page-transition wipe -------------------------------------
      // The View Transition API drives the crossfade; this paints a red sweep
      // over the top of it so navigation reads as a deliberate brand moment.
      document.addEventListener('astro:before-preparation', () => {
        document.documentElement.classList.add('is-navigating');
      });
      document.addEventListener('astro:after-swap', () => {
        window.scrollTo(0, 0);
      });
      document.addEventListener('astro:page-load', () => {
        const html = document.documentElement;
        html.classList.remove('is-navigating');
        html.classList.add('has-landed');
        window.setTimeout(() => html.classList.remove('has-landed'), 620);
      });

      // ---- light momentum scrolling --------------------------------------
      // The wheel feeds a virtual target and the page eases toward it, so a
      // notch lands with a short glide instead of a hard step. Tuned to be
      // barely there: a single notch settles in roughly a fifth of a second.
      // Touch devices keep their native inertia; the wheel is the only input
      // taken over. Bound once - window survives view transitions.
      (() => {
        const coarse = window.matchMedia('(pointer: coarse)').matches;
        const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (coarse || still) return;

        // Fraction of the remaining gap closed per 60Hz frame. Scaled to the
        // real frame time below, so a 144Hz monitor glides for the same
        // fifth of a second as a 60Hz one instead of snapping twice as fast.
        const EASE = 0.3;
        const FRAME = 1000 / 60;
        const PUSH = 1; // wheel throw multiplier - 1 means "no extra throw"
        // How far the glide target may ever sit from the current position.
        // Without this, fast scrolling piled wheel deltas onto the target and
        // the page kept coasting long after the wheel stopped - and because
        // the target was far below, scrolling back up could not overcome it
        // and the page appeared stuck going down.
        const LEAD = () => window.innerHeight * 0.6;

        // our own rAF loop does the easing, so CSS smoothing has to stand down
        document.documentElement.style.scrollBehavior = 'auto';

        let target = window.scrollY;
        let frame = 0;
        let lastTick = 0;

        const maxScroll = () =>
          Math.max(0, document.documentElement.scrollHeight - window.innerHeight);

        // The browser only scrolls in whole device pixels, so at 125% or 150%
        // display scaling scrollY moves in 0.8px or 0.67px steps. Easing by a
        // fraction of a small gap asks for a move smaller than one of those
        // steps, the position snaps straight back, and the gap never closes:
        // the loop used to spin forever at 60 scrollTo calls a second, which
        // is what jittered the sticky header and hero every time the page
        // came to rest near the top. Two exits now: close enough, or a frame
        // that asked to move and went nowhere.
        const run = (now: number) => {
          const here = window.scrollY;
          const gap = target - here;
          if (Math.abs(gap) < 1) {
            window.scrollTo(0, target);
            frame = 0;
            return;
          }
          // The first frame of a glide counts as one frame - the rAF
          // timestamp is the frame's start and can predate the wheel event
          // that started this. A long frame (tab hidden, main thread busy)
          // is capped so the glide never lurches to catch up.
          const dt = lastTick ? Math.min(Math.max(now - lastTick, 0), FRAME * 3) : FRAME;
          lastTick = now;
          const ease = 1 - Math.pow(1 - EASE, dt / FRAME);
          window.scrollTo(0, here + gap * ease);
          if (window.scrollY === here) {
            window.scrollTo(0, target);
            frame = 0;
            return;
          }
          frame = requestAnimationFrame(run);
        };

        const start = () => {
          if (frame) return;
          lastTick = 0;
          frame = requestAnimationFrame(run);
        };

        window.addEventListener(
          'wheel',
          (e) => {
            if (e.ctrlKey) return; // pinch zoom
            // the lightbox, the favourites rail, textareas and any other inner
            // scroller keep their own wheel.
            // e.target is not always an Element - it can be a text node or the
            // document - and getComputedStyle throws on those, which aborted
            // the handler before preventDefault and left scrolling erratic.
            // Only an inner scroller that can move on the wheel's own axis
            // gets to keep it: a vertical wheel over the favourites rail,
            // which only scrolls sideways, still glides the page rather
            // than dropping to a raw native jump.
            // (shift+wheel is a sideways scroll in Chrome, which still
            // reports it on deltaY)
            const vertical = !e.shiftKey && Math.abs(e.deltaY) >= Math.abs(e.deltaX);
            let node: Element | null = e.target instanceof Element ? e.target : null;
            while (node && node !== document.body && node !== document.documentElement) {
              const style = getComputedStyle(node);
              const canY = /(auto|scroll)/.test(style.overflowY) && node.scrollHeight > node.clientHeight + 1;
              const canX = /(auto|scroll)/.test(style.overflowX) && node.scrollWidth > node.clientWidth + 1;
              if (vertical ? canY : canX) return;
              node = node.parentElement;
            }
            // a sideways wheel that nothing claimed is the browser's to
            // ignore - it must not be turned into a vertical scroll
            if (!vertical) return;
            if (document.body.classList.contains('nav-locked')) return;

            e.preventDefault();

            // normalise line- and page-based wheels to pixels
            const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? window.innerHeight : 1;
            const here = window.scrollY;

            // A reversal drops any leftover glide instead of fighting it, so
            // the page turns around on the first upward notch.
            if (Math.sign(e.deltaY) !== Math.sign(target - here) && target !== here) {
              target = here;
            }

            target += e.deltaY * unit * PUSH;
            // keep the target within reach of where we actually are
            const lead = LEAD();
            target = Math.max(here - lead, Math.min(here + lead, target));
            target = Math.min(maxScroll(), Math.max(0, target));
            start();
          },
          { passive: false }
        );

        // anything that moves the page another way resets the target
        window.addEventListener(
          'scroll',
          () => {
            if (!frame) target = window.scrollY;
          },
          { passive: true }
        );
        window.addEventListener('resize', () => {
          target = Math.min(maxScroll(), window.scrollY);
        });
        // a page swap resets the scroll position, so reset the glide target too
        document.addEventListener('astro:after-swap', () => {
          target = 0;
          if (frame) {
            cancelAnimationFrame(frame);
            frame = 0;
          }
        });
      })();

      // ---- card tilt -----------------------------------------------------
      const wireTilt = () => {
        const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!fine || still) return;

        const MAX_Y = 7; // deg, left/right
        const MAX_X = 5; // deg, up/down

        document.querySelectorAll<HTMLElement>('.tilt').forEach((card) => {
          if (card.dataset.tilted) return;
          card.dataset.tilted = '1';
          let frame = 0;

          card.addEventListener('pointermove', (e) => {
            if (frame) return;
            frame = requestAnimationFrame(() => {
              frame = 0;
              const r = card.getBoundingClientRect();
              const px = (e.clientX - r.left) / r.width;
              const py = (e.clientY - r.top) / r.height;
              card.classList.add('is-tilting');
              card.style.setProperty('--ry', `${(px - 0.5) * 2 * MAX_Y}deg`);
              card.style.setProperty('--rx', `${(0.5 - py) * 2 * MAX_X}deg`);
              card.style.setProperty('--mx', `${px * 100}%`);
              card.style.setProperty('--my', `${py * 100}%`);
            });
          });

          card.addEventListener('pointerleave', () => {
            card.classList.remove('is-tilting');
            card.style.setProperty('--ry', '0deg');
            card.style.setProperty('--rx', '0deg');
            card.style.setProperty('--mx', '50%');
            card.style.setProperty('--my', '50%');
          });
        });
      };

      // ---- reveal on scroll ---------------------------------------------
      const wireReveal = () => {
        const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = document.querySelectorAll<HTMLElement>('.section, .stats-band, .cta-band, .testimonials');
        if (still) {
          targets.forEach((t) => t.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          // Positive bottom margin fires the reveal before the section reaches
          // the viewport, so a fast scroll never lands on a blank panel.
          { rootMargin: '0px 0px 22% 0px', threshold: 0 }
        );
        targets.forEach((t) => io.observe(t));
      };

      // ---- park off-screen animations ------------------------------------
      // The looping decorations (hero headline shine, flare buttons) keep the
      // main thread painting for as long as the page is open. The headline is
      // the costly one: a gradient sliding under background-clip: text cannot
      // be composited, so it repaints the letterforms every frame even once
      // the reader is three sections further down.
      //
      // Parking them outside the viewport is free - the frames skipped are the
      // ones nobody can see - and a paused animation resumes where it stopped,
      // so nothing on screen ever looks different.
      //
      // Viewport only, deliberately: a backgrounded tab already gets its CSS
      // animations stopped by the browser, so a document.hidden check here
      // would buy nothing and would freeze the page for good in any embedder
      // that reports itself hidden while the reader is looking at it.
      const wireIdleAnimations = () => {
        const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (still) return; // those animations are already off

        const looping = document.querySelectorAll<HTMLElement>('.hero h1 .line-2, .btn-flare');
        if (!looping.length) return;

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              (e.target as HTMLElement).classList.toggle('anim-idle', !e.isIntersecting);
            });
          },
          // a little lead-in, so an element is already running by the time its
          // first pixel is on screen
          { rootMargin: '200px 0px' }
        );

        looping.forEach((el) => {
          if (el.dataset.parked) return;
          el.dataset.parked = '1';
          io.observe(el);
        });
      };

      const boot = () => {
        wireTilt();
        wireReveal();
        wireIdleAnimations();
      };
      boot();
      document.addEventListener('astro:page-load', boot);
    </script>
  </body>
</html>
