---
import { v } from '../lib/asset';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Hex from '../components/Hex.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import HexBackdrop from '../components/HexBackdrop.astro';
import settings from '../data/settings.json';
import home from '../data/home.json';
import servicesData from '../data/services.json';

const services = servicesData.services.slice(0, 8);
---

<BaseLayout>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <picture class="hero-bg">
      <source media="(max-width: 780px)" srcset={v(home.hero_image_mobile)} />
      <img src={v(home.hero_image)} alt="" fetchpriority="high" width="1440" height="817" />
    </picture>

    <div class="container">
      <div class="hero-inner">
        <!-- Split so the copy, button and chips can drop below the photo on
             phones while the headline stays over it. -->
        <div class="hero-lede">
          <p class="eyebrow">{home.hero_eyebrow}</p>
          <h1>
            {home.hero_title_line1}
            <span class="line-2">{home.hero_title_line2}</span>
          </h1>
        </div>

        <div class="hero-rest">
          {home.hero_lead && <p class="hero-lead">{home.hero_lead}</p>}
          <p class="hero-copy">{home.hero_text}</p>

          <a class="btn-flare" href={home.hero_button_link}>
            <span class="btn-flare-label">{home.hero_button_label}</span>
            <span class="btn-flare-arrow"><Icon name="chevron" size={18} /></span>
          </a>

          <ul class="hero-chips">
            {
              home.hero_chips.map((c) => (
                <li>
                  <Icon name="check" size={17} />
                  <span>{c}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= SERVICES ================= -->
  <section class="section services hex-page" id="services">
    <HexBackdrop />
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{home.services_eyebrow}</p>
          <h2>{home.services_heading}</h2>
        </div>
        <p class="section-note">{home.services_note}</p>
      </div>

      <div class="service-grid" data-stagger>
        {
          services.map((s, i) => (
            <a class="service-card tilt" href="/services" style={`--i:${i}`}>
              <span class="glow" aria-hidden="true" />
              <span
                class="card-media"
                data-frames={JSON.stringify((s.images ?? [s.image]).map(v))}
                data-offset={i}
              >
                <img class="card-img is-on" src={v((s.images ?? [s.image])[0])} alt="" loading="lazy" decoding="async" width="800" height="600" />
                <img class="card-img card-img--next" alt="" aria-hidden="true" loading="lazy" width="800" height="600" />
              </span>
              <span class="service-card-body">
                <Hex icon={s.icon} size={24} />
                <h3>{s.title}</h3>
                <p>{s.short}</p>
              </span>
            </a>
          ))
        }
      </div>

      <div class="section-foot">
        <a class="btn btn--sm" href="/services">
          {home.services_button_label}
          <span class="btn-arrow"><Icon name="chevron" size={18} /></span>
        </a>
      </div>
    </div>
  </section>

  <div class="band-sep"></div>

  <!-- ================= FAVOURITES ================= -->
  <section class="section favorites">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{home.favorites_eyebrow}</p>
          <h2>{home.favorites_heading}</h2>
          <p class="section-note section-note--wide">{home.favorites_note}</p>
        </div>
        <a class="btn btn--sm" href="/gallery">
          {home.favorites_button_label}
          <span class="btn-arrow"><Icon name="chevron" size={18} /></span>
        </a>
      </div>
    </div>

    <div class="fav-rail" data-rail>
      <div class="fav-track">
        {
          home.favorites.map((f) => (
            <a class="fav-card" href="/gallery">
              <img src={v(f.image)} alt={f.title} loading="lazy" decoding="async" width="900" height="1125" />
              <span class="fav-meta">
                <span class="fav-title">{f.title}</span>
                <span class="fav-tags">{f.tags}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="band-sep"></div>

  <!-- ================= VISION ================= -->
  <section class="section vision hex-page">
    <HexBackdrop />
    <div class="container">
      <div class="vision-grid">
        <div class="vision-copy">
          <p class="eyebrow">{home.vision_eyebrow}</p>
          <h2>{home.vision_heading}</h2>
          <p>{home.vision_text}</p>
        </div>

        <ul class="vision-tiles">
          {
            home.vision_tiles.map((t) => (
              <li class="vision-tile">
                <Icon name={t.icon} size={30} stroke={1.5} />
                <h3>{t.title}</h3>
                <p>{t.text}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="vision-cta">
        <a class="btn-flare btn-flare--wide" href="/contact">
          <span class="btn-flare-label">{home.vision_button_label}</span>
          <span class="btn-flare-arrow"><Icon name="chevron" size={18} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= STATS ================= -->
  <section class="stats-band">
    <div class="container">
      <ul class="stats-grid">
        {
          home.stats.map((s) => (
            <li class="stat">
              <Hex icon={s.icon} size={22} />
              <div>
                <div class="stat-value">{s.value}</div>
                <div class="stat-label">{s.label}</div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="band-sep"></div>

  <!-- ================= ABOUT ================= -->
  <section class="section about-home">
    <div class="container">
      <div class="about-grid">
        <div class="about-media">
          <img src={v(home.about_image)} alt="Lifted Ford Super Duty built at The Shop Music City" loading="lazy" decoding="async" width="1440" height="1030" />
        </div>

        <div class="about-copy">
          <p class="eyebrow">{home.about_eyebrow}</p>
          <h2>{home.about_heading}</h2>
          <p>{home.about_text}</p>
          <ul class="check-list">
            {
              home.about_points.map((p) => (
                <li>
                  <Icon name="check" size={19} />
                  <span>{p}</span>
                </li>
              ))
            }
          </ul>
          <a class="btn btn--sm" href="/about">
            {home.about_button_label}
            <span class="btn-arrow"><Icon name="chevron" size={18} /></span>
          </a>
        </div>
      </div>

      <div class="brands">
        <p class="brands-heading">{home.brands_heading}</p>
        <ul class="brands-list">
          {home.brands.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <div class="band-sep"></div>

  <!-- ================= TESTIMONIALS ================= -->
  <Testimonials />

  <div class="band-sep"></div>

  <!-- ================= CTA ================= -->
  <CtaBand />
</BaseLayout>

<script>
  // Service cards cross-dissolve through the owner's ranked shots for that
  // service. Two stacked <img> layers so the swap never flashes, and each card
  // is offset so the grid doesn't change all at once.
  // The favourites rail drifts left on its own. It scrolls the real container
  // rather than transforming the track, so dragging, wheeling and the
  // scrollbar all keep working; the cards are duplicated once so the wrap is
  // seamless. Hovering or touching it pauses the drift.
  const wireFavRail = () => {
    const rail = document.querySelector<HTMLElement>('[data-rail]');
    const track = rail?.querySelector<HTMLElement>('.fav-track');
    if (!rail || !track || rail.dataset.drifting) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    rail.dataset.drifting = '1';

    // clone once for the seamless wrap
    const originals = Array.from(track.children) as HTMLElement[];
    const clones: HTMLElement[] = [];
    originals.forEach((node) => {
      const copy = node.cloneNode(true) as HTMLElement;
      copy.setAttribute('aria-hidden', 'true');
      copy.tabIndex = -1;
      track.appendChild(copy);
      clones.push(copy);
    });

    const SPEED = 22; // px per second - a slow drift, not a carousel
    let paused = false;
    let idleTimer = 0;
    let frame = 0;
    let last = 0;
    // scrollLeft reads back as an integer, so sub-pixel steps would round away
    // to nothing every frame. The true position is kept here as a float.
    let pos = rail.scrollLeft;

    // One period is the distance from an original to its clone. Half of
    // scrollWidth is not the same thing - that also carries the rail's
    // padding and half a gap, which would jump the wrap by ~30px.
    const period = () => clones[0].offsetLeft - originals[0].offsetLeft;

    const step = (now: number) => {
      const dt = last ? Math.min((now - last) / 1000, 0.05) : 0;
      last = now;

      if (!paused) {
        pos += SPEED * dt;
        const p = period();
        if (p > 0 && pos >= p) pos -= p;
        rail.scrollLeft = pos;
      } else {
        // stay in sync with wherever the reader dragged it
        pos = rail.scrollLeft;
      }
      frame = requestAnimationFrame(step);
    };

    const hold = (ms: number) => {
      paused = true;
      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => {
        paused = false;
      }, ms);
    };

    rail.addEventListener('pointerenter', () => {
      paused = true;
      window.clearTimeout(idleTimer);
    });
    rail.addEventListener('pointerleave', () => {
      paused = false;
    });
    rail.addEventListener('focusin', () => {
      paused = true;
    });
    rail.addEventListener('focusout', () => {
      paused = false;
    });
    // a manual flick or wheel takes over, then the drift resumes
    rail.addEventListener('wheel', () => hold(2500), { passive: true });
    rail.addEventListener('touchstart', () => hold(3500), { passive: true });

    // The drift is a rail-full-of-photos effect, and it was running from the
    // moment the page loaded to the moment it closed: a frame every 16ms
    // writing scrollLeft on a horizontal scroller sitting a screen and a half
    // below the fold, forcing layout each time. Tied to the rail's own
    // visibility it does exactly what it did before while anyone can see it,
    // and nothing at all while they cannot.
    const run = () => {
      if (frame) return;
      last = 0; // a resumed loop must not bill itself for the time it sat idle
      frame = requestAnimationFrame(step);
    };
    const halt = () => {
      if (!frame) return;
      cancelAnimationFrame(frame);
      frame = 0;
    };

    // Viewport only - a backgrounded tab stops serving animation frames on its
    // own, so the loop is already idle there without a second check that could
    // strand it.
    new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? run() : halt()));
      },
      { rootMargin: '100px 0px' }
    ).observe(rail);

    document.addEventListener('astro:before-swap', halt, { once: true });
  };

  const wireCardRotation = () => {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (still) return;

    const HOLD = 3000;

    document.querySelectorAll<HTMLElement>('.card-media').forEach((media) => {
      if (media.dataset.rotating) return;

      let frames: string[] = [];
      try {
        frames = JSON.parse(media.dataset.frames ?? '[]');
      } catch {
        return;
      }
      if (frames.length < 2) return;

      media.dataset.rotating = '1';

      const layers = media.querySelectorAll<HTMLImageElement>('.card-img');
      const front = layers[0];
      const back = layers[1];
      if (!front || !back) return;

      let at = 0;
      let showingFront = true;
      let warmed = false;

      // Warming the cache is what makes a swap land on a whole frame rather
      // than a half-loaded one, but doing it at boot for every card pulled all
      // fourteen extra shots - about a megabyte and a half, and fourteen full
      // decodes - down the wire while the phone was still trying to paint the
      // hero. Deferred to the card's first appearance, it costs the same but
      // arrives when there is nothing competing with it.
      const warm = () => {
        if (warmed) return;
        warmed = true;
        frames.slice(1).forEach((src) => {
          const pre = new Image();
          pre.src = src;
        });
      };

      const step = () => {
        at = (at + 1) % frames.length;
        const incoming = showingFront ? back : front;
        const outgoing = showingFront ? front : back;

        incoming.src = frames[at];
        const reveal = () => {
          incoming.classList.add('is-on');
          outgoing.classList.remove('is-on');
          showingFront = !showingFront;
        };
        if (incoming.complete) reveal();
        else incoming.addEventListener('load', reveal, { once: true });
      };

      // The rotation only means anything while the card is on screen. Run for
      // all eight from boot and the page carries eight permanent timers, each
      // one swapping an <img> src and cross-fading two layers of a card that
      // is nowhere near the viewport - and it keeps doing it in a backgrounded
      // tab. Gated on visibility it is the same effect, paid for only while
      // someone is looking at it.
      const offset = Number(media.dataset.offset ?? 0) * 380;
      let timer = 0;
      let opening = 0;

      const stop = () => {
        window.clearTimeout(opening);
        window.clearInterval(timer);
        opening = 0;
        timer = 0;
      };

      // The stagger is what keeps the grid from turning over all at once, so
      // it is spent on the first appearance; coming back to a card that has
      // already run picks straight up.
      const start = () => {
        if (timer || opening) return;
        const begin = () => {
          opening = 0;
          timer = window.setInterval(step, HOLD);
        };
        if (warmed) begin();
        else {
          warm();
          opening = window.setTimeout(begin, offset);
        }
      };

      let visible = false;
      const sync = () => {
        if (visible && !document.hidden) start();
        else stop();
      };

      new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            visible = e.isIntersecting;
            sync();
          });
        },
        { rootMargin: '150px 0px' }
      ).observe(media);

      document.addEventListener('visibilitychange', sync);
      document.addEventListener(
        'astro:before-swap',
        () => {
          stop();
          document.removeEventListener('visibilitychange', sync);
        },
        { once: true }
      );
    });
  };

  const bootHome = () => {
    wireCardRotation();
    wireFavRail();
  };
  bootHome();
  document.addEventListener('astro:page-load', bootHome);
</script>
