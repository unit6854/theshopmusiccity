---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import Hex from '../components/Hex.astro';
import HexBackdrop from '../components/HexBackdrop.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FaqList from '../components/FaqList.astro';
import contact from '../data/contact.json';
import settings from '../data/settings.json';

const cards = [
  {
    icon: 'pin-solid',
    label: 'Visit',
    lines: [settings.address_line1, settings.address_line2],
    note: 'Round the back on Myatt Drive.',
    action: { label: 'Get directions', href: settings.map_url, external: true },
  },
  {
    icon: 'phone',
    label: 'Call',
    lines: [settings.phone],
    note: 'Fastest way to reach the shop.',
    action: { label: 'Call now', href: settings.phone_link, external: false },
  },
  {
    icon: 'mail',
    label: 'Email',
    lines: [settings.email],
    note: 'Send photos and we will quote it.',
    action: { label: 'Send an email', href: `mailto:${settings.email}`, external: false },
  },
];
---

<BaseLayout
  title="Contact | The Shop Music City"
  description={`Call ${settings.phone} or stop by 517 Myatt Drive, Suite A in Madison, TN. Window tint, wraps, PPF and detailing quotes.`}
>
  <PageHead eyebrow="Contact" title={contact.title} intro={contact.intro} />

  <!-- ============ REACH US ============ -->
  <section class="section section--tight hex-page contact-reach">
    <HexBackdrop />
    <div class="container">
      <ul class="reach-grid">
        {
          cards.map((c) => (
            <li class="reach-card">
              <span class="reach-hex"><Hex icon={c.icon} size={22} /></span>
              <h2>{c.label}</h2>
              <div class="reach-lines">
                {c.lines.map((l) => <span>{l}</span>)}
              </div>
              <p class="reach-note">{c.note}</p>
              <a
                class="reach-link"
                href={c.action.href}
                target={c.action.external ? '_blank' : undefined}
                rel={c.action.external ? 'noopener' : undefined}
              >
                {c.action.label}
                <Icon name="arrow-right" size={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ HOURS + PAYMENT ============ -->
  <section class="section section--tight">
    <div class="container">
      <div class="contact-split">
        <article class="slab">
          <p class="eyebrow">Opening Hours</p>
          <h2>When we are in the bay.</h2>
          <table class="hours-table">
            <tbody>
              {
                settings.hours.map((h) => (
                  <tr class={h.time === 'Closed' ? 'is-closed' : undefined}>
                    <td>{h.days}</td>
                    <td>{h.time}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </article>

        <article class="slab">
          <p class="eyebrow">Payment</p>
          <h2>However you want to pay.</h2>
          <ul class="pay-list">
            {settings.payment_methods.split(',').map((m) => <li>{m.trim()}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <div class="band-sep"></div>

  <!-- ============ QUOTE FORM ============ -->
  <section class="section hex-page contact-form-section">
    <HexBackdrop />
    <div class="container" style="max-width:920px;">
      <QuoteForm />
    </div>
  </section>

  <div class="band-sep"></div>

  <!-- ============ FAQ ============ -->
  <section class="section">
    <div class="container" style="max-width:900px;">
      <div class="section-head">
        <div>
          <p class="eyebrow">Before You Call</p>
          <h2>Common Questions.</h2>
        </div>
      </div>
      <FaqList limit={4} />
      <div class="section-foot">
        <a class="btn btn--sm" href="/faq">
          All FAQs
          <span class="btn-arrow"><Icon name="chevron" size={18} /></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
