---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import ReviewCard from '../components/ReviewCard.astro';
import CtaBand from '../components/CtaBand.astro';
import contact from '../data/contact.json';
import settings from '../data/settings.json';
import { reviews } from '../lib/content';
---

<BaseLayout
  title="Reviews | The Shop Music City"
  description="Five-star reviews for window tinting, vinyl wraps and detailing at The Shop Music City in Madison, TN."
>
  <PageHead eyebrow="Reviews" title={contact.reviews_title} intro={contact.reviews_intro}>
    <div class="page-head-rating">
      <span class="stars" aria-label="5 star rating">
        {[1, 2, 3, 4, 5].map(() => <Icon name="star" size={20} />)}
      </span>
      <span class="rating-note">{settings.rating} stars across {settings.review_count}+ Google reviews</span>
    </div>
  </PageHead>

  <section class="section">
    <div class="container">
      <div class="extras-grid">
        {reviews.map((r) => <ReviewCard review={r} />)}
      </div>

      <div class="section-foot">
        <a class="btn" href={settings.google_url} target="_blank" rel="noopener">
          Read More On Google
          <span class="btn-arrow"><Icon name="chevron" size={18} /></span>
        </a>
      </div>
    </div>
  </section>

  <div class="band-sep"></div>

  <CtaBand />
</BaseLayout>
