---
import Icon from './Icon.astro';
import settings from '../data/settings.json';
import home from '../data/home.json';
import { featuredReviews, reviews } from '../lib/content';

const items = (featuredReviews.length ? featuredReviews : reviews).slice(0, 6);
---

<section class="testimonials">
  <img class="testimonials-bg" src={home.testimonials_image} alt="" loading="lazy" />
  <div class="container">
    <h2>{home.testimonials_heading}</h2>

    <div class="stars" aria-label="5 star rating">
      {[1, 2, 3, 4, 5].map(() => <Icon name="star" size={20} />)}
    </div>
    <p class="rating-note">
      {settings.rating} stars on <a href={settings.google_url} target="_blank" rel="noopener">Google</a>
      &nbsp;•&nbsp; Owner-operated in Madison since {settings.founded}
    </p>

    <div class="slider" data-slider>
      <button class="slider-btn" type="button" data-prev aria-label="Previous review">
        <Icon name="chevron-left" size={20} />
      </button>

      <div class="slide-track">
        {
          items.map((r, i) => (
            <figure class:list={['slide', i === 0 && 'is-active']} data-slide>
              <div class="quote-mark" aria-hidden="true">&#8220;</div>
              <blockquote>“{r.quote}”</blockquote>
              <cite>– {r.name}</cite>
            </figure>
          ))
        }
      </div>

      <button class="slider-btn" type="button" data-next aria-label="Next review">
        <Icon name="chevron" size={20} />
      </button>
    </div>

    <div class="dots" data-dots>
      {
        items.map((_, i) => (
          <button class:list={['dot', i === 0 && 'is-active']} type="button" data-dot aria-label={`Review ${i + 1}`} />
        ))
      }
    </div>
  </div>
</section>

<script>
  // Re-bound per navigation so the slider keeps working after a view transition.
  const wire = () => {
    const root = document.querySelector('[data-slider]');
    if (!root) return;
    const slides = Array.from(document.querySelectorAll('[data-slide]'));
    const dots = Array.from(document.querySelectorAll('[data-dot]'));
    if (!slides.length) return;
    let i = 0;

    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, x) => s.classList.toggle('is-active', x === i));
      dots.forEach((d, x) => d.classList.toggle('is-active', x === i));
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => show(i - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(i + 1));
    dots.forEach((d, x) => d.addEventListener('click', () => show(x)));

    let timer = setInterval(() => show(i + 1), 7000);
    root.addEventListener('mouseenter', () => clearInterval(timer));
    root.addEventListener('mouseleave', () => {
      timer = setInterval(() => show(i + 1), 7000);
    });
    document.addEventListener('astro:before-swap', () => clearInterval(timer), { once: true });
  };

  wire();
  document.addEventListener('astro:page-load', wire);
</script>
