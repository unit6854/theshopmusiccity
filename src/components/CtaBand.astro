---
import { v } from '../lib/asset';
import Icon from './Icon.astro';
import settings from '../data/settings.json';
import home from '../data/home.json';
---

<section class="cta-band">
  <img class="cta-bg" src={v(home.about_image)} alt="" loading="lazy" />
  <div class="container">
    <div class="cta-box">
      <div class="cta-text">
        <h2>
          {home.cta_line1}
          <span class="line-2">{home.cta_line2}</span>
        </h2>
        <p>{home.cta_text}</p>
      </div>

      <div class="cta-actions">
        <a class="btn-flare" href={settings.phone_link}>
          <span class="btn-flare-icon"><Icon name="phone" size={19} /></span>
          <span class="btn-flare-label">{settings.phone}</span>
        </a>
        <a class="btn" href="/contact">
          {home.cta_button_label}
          <span class="btn-arrow"><Icon name="chevron" size={18} /></span>
        </a>
      </div>
    </div>
  </div>
</section>
